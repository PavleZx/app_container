@model RPPP_WebApp.Model.IndividualAnimals

@{
    ViewData["Title"] = "Edit IndividualAnimals";
}

<h1>Edit Individual Animal</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" name="page" value="@ViewData["page"]" />
    <input type="hidden" name="sort" value="@ViewData["sort"]" />
    <input type="hidden" name="ascending" value="@ViewData["ascending"]" />

        <div class="form-group">
        <label asp-for="SerialNum" class="control-label"></label>
        <input asp-for="SerialNum" class="form-control" />
        <span asp-validation-for="SerialNum" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Nickname" class="control-label"></label>
        <input asp-for="Nickname" class="form-control"/>
        <span asp-validation-for="Nickname" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Acquisition" class="control-label"></label>
        <input asp-for="Acquisition" class="form-control" />
        <span class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Status" class="control-label"></label>
        <input asp-for="Status" class="form-control" />
        <span class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EnclosureID" class="control-label"></label>
        <select asp-for="EnclosureID" class="form-control">
            <option value="">Select Enclosure</option>
            @foreach (var enclosure in (IEnumerable<SelectListItem>)ViewData["EnclosureID"])
            {
                <option value="@enclosure.Value">@enclosure.Text</option>
            }
        </select>
        <span asp-validation-for="EnclosureID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NameID" class="control-label"></label>
        <select asp-for="NameID" class="form-control">
            <option value="">Select Type</option>
            @foreach (var name in (IEnumerable<SelectListItem>)ViewData["NameID"])
            {
                <option value="@name.Value">@name.Text</option>
            }
        </select>
        <span asp-validation-for="NameID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="hidden" asp-for="AnimalID" />
        <input type="submit" value="Save Changes" class="btn btn-primary" />
        <a asp-action="Index"
           asp-route-page="@ViewData["page"]" 
           asp-route-sort="@ViewData["sort"]" 
           asp-route-ascending="@ViewData["ascending"]" 
           class="btn btn-primary">
           Cancel
        </a>
    </div>
</form>
