@model RPPP_WebApp.Model.Affects

@{
    ViewData["Title"] = "Add Affects";
}

<h2>Add New Affects Record</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post" asp-route-returnUrl="@ViewBag.ReturnUrl">
            
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="reportID" class="control-label">Incident Report</label>
                <select asp-for="reportID" class="form-control" asp-items="ViewBag.ReportList">
                </select>
                <span asp-validation-for="reportID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="groupID" class="control-label">Group ID</label>
                <input asp-for="groupID" class="form-control" type="number" />
                <span asp-validation-for="groupID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="enclosureID" class="control-label">Enclosure</label>
                <select asp-for="enclosureID" class="form-control" asp-items="ViewBag.EnclosureList">
                    <option value="">-- None --</option>
                </select>
                <span asp-validation-for="enclosureID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="animalID" class="control-label">Animal</label>
                <select asp-for="animalID" class="form-control" asp-items="ViewBag.AnimalList">
                    <option value="">-- None --</option>
                </select>
                <span asp-validation-for="animalID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="description" class="control-label">Description</label>
                <textarea asp-for="description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="description" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Save</button>
                
                <a href="@(ViewBag.ReturnUrl ?? Url.Action("MasterDetail", "IncidentReport", new { id = Model.reportID > 0 ? Model.reportID : (int?)null }))" 
                   class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>