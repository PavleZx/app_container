@model RPPP_WebApp.Model.Affects

@{
    ViewData["Title"] = "Edit Affects Record";
}

<h2>Edit Affects Record</h2>

<form asp-action="Edit"
      asp-route-id="@Model.affectsID"
      asp-route-returnUrl="@ViewBag.ReturnUrl" 
      asp-route-page="@ViewBag.Page"
      asp-route-sort="@ViewBag.Sort"
      asp-route-ascending="@ViewBag.Ascending"
      method="post">
    
    @Html.AntiForgeryToken()
    
    <input type="hidden" asp-for="affectsID" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="reportID" class="control-label">Incident Report</label>
        <select asp-for="reportID"
                asp-items="ViewBag.ReportList"
                class="form-control">
            </select>
        <span asp-validation-for="reportID" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="groupID" class="control-label">Group ID</label>
        <input asp-for="groupID" class="form-control" type="number" />
        <span asp-validation-for="groupID" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="enclosureID" class="control-label">Enclosure</label>
        <select asp-for="enclosureID"
                asp-items="ViewBag.EnclosureList"
                class="form-control">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="enclosureID" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="animalID" class="control-label">Animal</label>
        <select asp-for="animalID"
                asp-items="ViewBag.AnimalList"
                class="form-control">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="animalID" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="description" class="control-label">Description</label>
        <textarea asp-for="description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="description" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        
        <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index", new { page = ViewBag.Page, sort = ViewBag.Sort, ascending = ViewBag.Ascending }))" 
           class="btn btn-secondary">
            Cancel
        </a>
    </div>
</form>