@model RPPP_WebApp.ViewModels.VisitGroupGroupGuideMDModel

<h1>Visiting group details</h1>
<a asp-action="MasterDetailPdf"
   asp-route-id="@Model.VisitGroup.VisitGroupId"
   class="btn btn-outline-secondary">
    Generate PDF
</a>
<div class="card mb-4">
    <div class="card-header">
        <h3>Visit group information</h3>
    </div>

    <form asp-action="MasterDetailEditVisitGroup" method="post">
        @Html.AntiForgeryToken()

        <div class="card-body">
            <dl class="row">

                <dt class="col-sm-3">Visit group ID</dt>
                <dd class="col-sm-9">
                    @Model.VisitGroup.VisitGroupId
                    <input type="hidden" asp-for="VisitGroup.VisitGroupId" />
                </dd>

                <dt class="col-sm-3">Visit group name</dt>
                <dd class="col-sm-9">
                    <input asp-for="VisitGroup.GroupName" class="form-control" />
                    <span asp-validation-for="VisitGroup.GroupName" class="text-danger"></span>
                </dd>

                <dt class="col-sm-3">Date of visit</dt>
                <dd class="col-sm-9">
                    <input asp-for="VisitGroup.DateOfVisiting" type="date" class="form-control" />
                    <span asp-validation-for="VisitGroup.DateOfVisiting" class="text-danger"></span>
                </dd>

                <dt class="col-sm-3">Approval</dt>
                <dd class="col-sm-9">
                    <input asp-for="VisitGroup.Approval" class="form-control" />
                    <span asp-validation-for="VisitGroup.Approval" class="text-danger"></span>
                </dd>

                <dt class="col-sm-3">Visitor count</dt>
                <dd class="col-sm-9">
                    <input asp-for="VisitGroup.VisitorCount" class="form-control" />
                    <span asp-validation-for="VisitGroup.VisitorCount" class="text-danger"></span>
                </dd>

                <dt class="col-sm-3">Tour type</dt>
                <dd class="col-sm-9">
                    <input asp-for="VisitGroup.TourId"
                           type="hidden"
                           data-autocomplete-placeholder="tourtypes" />

                    <input type="text"
                           class="form-control"
                           value="@Model.VisitGroup.Tour?.TourName"
                           data-autocomplete="tourtypes"
                           data-autocomplete-placeholder-name="tourtypes"
                           placeholder="Start typing tour name..." />

                    <span asp-validation-for="VisitGroup.TourId" class="text-danger"></span>
                </dd>

            </dl>
        </div>

        <button type="submit" class="btn btn-primary">
            Save
        </button>
    </form>

    <form asp-action="Delete"
          method="post"
          onsubmit="return confirm('Are you sure you want to delete this group?');">
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="visitGroupId"
               value="@Model.VisitGroup.VisitGroupId" />

        <button type="submit" class="btn btn-outline-danger">
            Delete group
        </button>
    </form>
</div>

<div class="card">
    <div class="card-header">
        <h3>Associated Guides</h3>
    </div>

    <div class="card-body">
        <form asp-action="SaveGroupGuidesBatch" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="VisitGroupId"
                   value="@Model.VisitGroup.VisitGroupId" />

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Guide</th>
                        <th>Phone</th>
                        <th>Guide role</th>
                        <th>Activity</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.GroupGuides.Count; i++)
                    {
                        <tr class="group-guide-row">

                            <td>
                                @Model.GroupGuides[i].GroupGuideId
                                <input type="hidden" asp-for="GroupGuides[i].GroupGuideId" />
                                <input type="hidden" asp-for="GroupGuides[i].VisitGroupId" />
                                <input type="hidden"
                                       asp-for="GroupGuides[i].IsDeleted"
                                       class="is-deleted-flag" />
                            </td>

                            <td>
                                <input asp-for="GroupGuides[i].WorkerId"
                                       type="hidden"
                                       data-autocomplete-placeholder="workers-@i" />

                                <input type="text"
                                       class="form-control form-control-sm worker-autocomplete"
                                       value="@Model.GroupGuides[i].Worker?.Name @Model.GroupGuides[i].Worker?.Surname"
                                       data-autocomplete="workers"
                                       data-autocomplete-placeholder-name="workers-@i"
                                       data-phone-target="phone-@i"
                                       placeholder="Type name or surname..." />

                                <span asp-validation-for="GroupGuides[i].WorkerId"
                                      class="text-danger"></span>
                            </td>

                            <td>
                                <span id="phone-@i">
                                    @Model.GroupGuides[i].Worker?.Phone
                                </span>
                            </td>

                            <td>
                                <select asp-for="GroupGuides[i].GuideRole"
                                        class="form-control form-control-sm">
                                    <option value="">-- select role --</option>
                                    <option value="Main Guide">Main Guide</option>
                                    <option value="Assistant">Assistant</option>
                                    <option value="Trainee">Trainee</option>
                                </select>

                                <span asp-validation-for="GroupGuides[i].GuideRole"
                                      class="text-danger"></span>

                            </td>

                            <td>
                                <input asp-for="GroupGuides[i].Activity"
                                       class="form-control form-control-sm" />
                                <span asp-validation-for="GroupGuides[i].Activity"
                                      class="text-danger"></span>
                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-danger btn-sm delete-row">
                                    Remove
                                </button>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>

            <button type="submit" class="btn btn-success">
                Save all changes
            </button>
        </form>
        <div class="mt-3">
            <button type="button"
                    id="add-guide"
                    class="btn btn-primary">
                Add a new guide
            </button>
        </div>
    </div>
</div>



<table style="display:none">
    <tbody id="guide-row-template">
        <tr class="group-guide-row">

            <td>
                new
                <input type="hidden" name="GroupGuides[__index__].GroupGuideId" value="0" />
                <input type="hidden" name="GroupGuides[__index__].VisitGroupId"
                       value="@Model.VisitGroup.VisitGroupId" />
                <input type="hidden" name="GroupGuides[__index__].IsDeleted"
                       value="false"
                       class="is-deleted-flag" />
            </td>

            <td>
                <input type="hidden"
                       name="GroupGuides[__index__].WorkerId"
                       data-autocomplete-placeholder="workers-__index__" />

                <input type="text"
                       class="form-control form-control-sm worker-autocomplete"
                       data-autocomplete="workers"
                       data-autocomplete-placeholder-name="workers-__index__"
                       data-phone-target="phone-__index__"
                       placeholder="Type name or surname..." />
            </td>

            <td>
                <span id="phone-__index__"></span>
            </td>

            <td>
                <select name="GroupGuides[__index__].GuideRole"
                        class="form-control form-control-sm">
                    <option value="">-- select role --</option>
                    <option value="Main Guide">Main Guide</option>
                    <option value="Assistant">Assistant</option>
                    <option value="Trainee">Trainee</option>
                </select>

            </td>

            <td>
                <input name="GroupGuides[__index__].Activity"
                       class="form-control form-control-sm" />
            </td>

            <td>
                <button type="button"
                        class="btn btn-danger btn-sm delete-row">
                    Remove
                </button>
            </td>

        </tr>
    </tbody>
</table>

@section Scripts {
    <script>
        let guideIndex = @Model.GroupGuides.Count;

        document.getElementById("add-guide").addEventListener("click", function () {
            let template = document
                .getElementById("guide-row-template")
                .innerHTML
                .replaceAll("__index__", guideIndex);

            const tbody = document.querySelector(".table tbody");
            tbody.insertAdjacentHTML("beforeend", template);

            initAutocomplete(tbody.lastElementChild);

            guideIndex++;
        });


        document.addEventListener("click", function (e) {
            if (e.target.classList.contains("delete-row")) {
                const row = e.target.closest("tr");
                row.querySelector(".is-deleted-flag").value = "true";
                row.style.display = "none";
            }
        });

        document.addEventListener("focusin", function (e) {
            if (e.target.classList.contains("worker-autocomplete")) {
                if (!e.target.dataset.initialized) {
                    initWorkerAutocomplete(e.target);
                    e.target.dataset.initialized = "true";
                }
            }
        });
    </script>
}
