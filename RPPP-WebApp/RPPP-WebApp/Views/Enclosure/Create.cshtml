@model RPPP_WebApp.Model.Enclosure

@{
    ViewData["Title"] = "Create Enclosure";
}

<h1>Create Enclosure</h1>

<form asp-action="Create" method="post">
    <input type="hidden" name="returnAction" value="@ViewData["returnAction"]" />
    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Dimensions" class="control-label"></label>
        <textarea asp-for="Dimensions" class="form-control"></textarea>
        <span asp-validation-for="Dimensions" class="text-danger"></span>
    </div>
        <div class="form-group">
        <label asp-for="Change" class="control-label"></label>
        <textarea asp-for="Change" class="form-control"></textarea>
        <span asp-validation-for="Change" class="text-danger"></span>
    </div>
        <div class="form-group">
        <label asp-for="Lighting" class="control-label"></label>
        <textarea asp-for="Lighting" class="form-control"></textarea>
        <span asp-validation-for="Lighting" class="text-danger"></span>
    </div>
        <div class="form-group">
        <label asp-for="Shading" class="control-label"></label>
        <textarea asp-for="Shading" class="form-control"></textarea>
        <span asp-validation-for="Shading" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LocationID" class="control-label"></label>
        <select asp-for="LocationID" class="form-control">
            <option value="">Select Location</option>
            @foreach (var location in (IEnumerable<SelectListItem>)ViewData["LocationID"])
            {
                <option value="@location.Value">@location.Text</option>
            }
        </select>
        <span asp-validation-for="LocationID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="AnimalTypeID" class="control-label"></label>
        <select asp-for="AnimalTypeID" class="form-control">
            <option value="">Select Animal</option>
            @foreach (var animal in (IEnumerable<SelectListItem>)ViewData["AnimalTypeID"])
            {
                <option value="@animal.Value">@animal.Text</option>
            }
        </select>
        <span asp-validation-for="AnimalTypeID" class="text-danger"></span>
    </div>

    <input type="hidden" name="page" value="@ViewData["page"]" />
    <input type="hidden" name="sort" value="@ViewData["sort"]" />
    <input type="hidden" name="ascending" value="@ViewData["ascending"]" /> 
    
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" 
           asp-route-page="@ViewData["page"]" 
           asp-route-sort="@ViewData["sort"]" 
           asp-route-ascending="@ViewData["ascending"]" 
           class="btn btn-primary">
           Cancel
        </a>
    </div>
</form>


