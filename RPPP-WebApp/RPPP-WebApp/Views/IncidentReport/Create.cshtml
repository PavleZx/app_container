@model RPPP_WebApp.Model.IncidentReport

@{
    ViewData["Title"] = "Create Incident Report";
}

<h2>Add New Incident Report</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="DateReport" class="control-label">Date Reported</label>
        <input asp-for="DateReport" class="form-control" type="date" />
        <span asp-validation-for="DateReport" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DateSolved" class="control-label">Date Solved</label>
        <input asp-for="DateSolved" class="form-control" type="date" />
        <span asp-validation-for="DateSolved" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Status" class="control-label"></label>
        <input asp-for="Status" class="form-control" placeholder="Enter status (e.g. Open, Closed)" />
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TypeID" class="control-label">Incident Type</label>
        <select asp-for="TypeID" 
                asp-items="ViewBag.IncidentTypeList" 
                class="form-control">
            <option value="">-- Select Incident Type --</option>
        </select>
        <span asp-validation-for="TypeID" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        
        <a asp-action="Index" 
           asp-route-page="@ViewBag.Page" 
           asp-route-sort="@ViewBag.Sort" 
           asp-route-ascending="@ViewBag.Ascending" 
           class="btn btn-secondary">Cancel</a>
    </div>
</form>
